#!/usr/bin/env zsh

emulate -LR zsh
set -euo pipefail

repo_root=${0:A:h:h}
SCRIPT_NAME=install-skills
source "$repo_root/scripts/lib/install-common.zsh"
source "$repo_root/scripts/lib/skill-acquisition.zsh"
source "$repo_root/scripts/lib/agent-skills-layer.zsh"

ACQUISITION_SOURCE_BASE_DIR="$repo_root"
skills_root="$repo_root/ai/skills"
registry_path="$skills_root/skills.json"
force=0
local_only=0

usage() {
  cat <<'EOF'
Использование: ./scripts/install-skills [--local-only|--update|--force]

Синхронизирует локальные навыки из ai/skills/* и внешние зависимости
из ai/skills/skills.json с ~/.agents/skills, затем обновляет проекции
для ассистентов в ~/.claude/skills, ~/.codex/skills и ~/.cursor/skills.

Параметры:
  --local-only      Обновить только локальные навыки и проекции.
  --update, --force Переустановить внешние навыки перед синхронизацией.
EOF
}

while (( $# > 0 )); do
  case "$1" in
    --local-only)
      local_only=1
      ;;
    --update|--refresh)
      force=1
      ;;
    --force)
      force=1
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      die "install-skills: неизвестный параметр: $1"
      ;;
  esac
  shift
done

(( local_only && force )) \
  && die "install-skills: параметры --local-only и --update несовместимы"

if (( local_only )); then
  require_commands diff
else
  require_commands jq npx fd diff git ugrep
fi

mkdir -p "$AGENT_SKILLS_CANONICAL_DIR"

tmpdir=$(make_tmpdir dotfiles-skills)
trap 'rm -rf "$tmpdir"' EXIT

typeset -A local_skill_dirs external_skill_sources
typeset -Ua managed_names
managed_names=()
source_index=0

sync_local_skill_dir() {
  local target_dir=$1
  local source_dir=$2

  if [[ -L "$source_dir" ]]; then
    rm -rf "$target_dir"
    ln -s "${source_dir:A}" "$target_dir"
    return
  fi

  replace_dir "$target_dir" "$source_dir"
}

register_external_skill() {
  local name=$1
  local source=$2

  [[ -n "$name" ]] || die "install-skills: пустое имя внешнего навыка из источника: $source"

  if [[ -n ${local_skill_dirs[$name]-} ]]; then
    die "install-skills: конфликт имени: внешний навык '$name' из $source совпадает с локальным навыком ${local_skill_dirs[$name]}"
  fi

  if [[ -n ${external_skill_sources[$name]-} ]]; then
    die "install-skills: конфликт имени: внешний навык '$name' из $source совпадает с ${external_skill_sources[$name]}"
  fi

  external_skill_sources[$name]=$source
}

for skill_dir in "$skills_root"/*(N-/); do
  [[ -f "$skill_dir/SKILL.md" ]] || continue

  name=${skill_dir:t}
  local_skill_dirs[$name]=$skill_dir
  sync_local_skill_dir "$AGENT_SKILLS_CANONICAL_DIR/$name" "$skill_dir"
  managed_names+=("$name")
done

if (( local_only )); then
  agent_skills_reconcile_layer
  print "install-skills: синхронизировано локальных навыков: ${#managed_names[@]}"
  exit 0
fi

if [[ -f "$registry_path" ]]; then
  skill_entries=("${(@f)$(acquisition_skill_specs "$registry_path")}")

  for entry in "${skill_entries[@]}"; do
    source=$(jq -r '.source' <<<"$entry")
    install_all=$(jq -r 'if .install_all then 1 else 0 end' <<<"$entry")
    selected_skills=("${(@f)$(acquisition_spec_skills "$entry")}")
    excluded_skills=("${(@f)$(acquisition_spec_excluded_skills "$entry")}")
    if (( ${#selected_skills[@]} == 1 )) && [[ -z ${selected_skills[1]} ]]; then
      selected_skills=()
    fi
    if (( ${#excluded_skills[@]} == 1 )) && [[ -z ${excluded_skills[1]} ]]; then
      excluded_skills=()
    fi
    stage_dir="$tmpdir/source-$source_index"
    ((source_index += 1))

    requested_names=("${selected_skills[@]}")
    (( install_all || ${#requested_names[@]} )) || die "install-skills: пустой список навыков для источника: $source"

    if (( install_all )); then
      print "install-skills: загрузка: $source"
      acquisition_stage_skills "$stage_dir" "$source" "${selected_skills[@]}"

      staged_paths=("${(@f)$(acquisition_staged_skill_paths "$stage_dir")}")
      if (( ${#staged_paths[@]} == 1 )) && [[ -z ${staged_paths[1]} ]]; then
        staged_paths=()
      fi
      (( ${#staged_paths[@]} )) || die "install-skills: источник не подготовил навыки: $source"

      typeset -A excluded_skill_names
      excluded_skill_names=()
      for name in "${excluded_skills[@]}"; do
        excluded_skill_names[$name]=1
      done

      for skill_path in "${staged_paths[@]}"; do
        name=${skill_path:t}
        [[ -n ${excluded_skill_names[$name]-} ]] && continue
        register_external_skill "$name" "$source"
        if [[ -L "$AGENT_SKILLS_CANONICAL_DIR/$name" ]]; then
          print "install-skills: локальное переопределение: $name"
          managed_names+=("$name")
          continue
        fi
        replace_dir "$AGENT_SKILLS_CANONICAL_DIR/$name" "$skill_path"
        managed_names+=("$name")
      done
      continue
    fi

    for name in "${requested_names[@]}"; do
      register_external_skill "$name" "$source"
    done

    # Ручная символическая ссылка в каноническом каталоге считается локальным
    # переопределением и сохраняется без изменений.
    typeset -a override_names install_names
    override_names=()
    install_names=()
    for name in "${requested_names[@]}"; do
      if [[ -L "$AGENT_SKILLS_CANONICAL_DIR/$name" ]]; then
        override_names+=("$name")
      else
        install_names+=("$name")
      fi
    done

    if (( ${#override_names[@]} )); then
      print "install-skills: локальное переопределение: ${override_names[*]}"
      managed_names+=("${override_names[@]}")
    fi

    (( ${#install_names[@]} )) || continue

    needs_install=$force
    if (( ! needs_install )); then
      for name in "${install_names[@]}"; do
        [[ -d "$AGENT_SKILLS_CANONICAL_DIR/$name" ]] || { needs_install=1; break; }
      done
    fi

    if (( ! needs_install )); then
      managed_names+=("${install_names[@]}")
      print "install-skills: уже установлено: $source"
      continue
    fi

    print "install-skills: загрузка: $source"
    acquisition_stage_skills "$stage_dir" "$source" "${install_names[@]}"

    for name in "${install_names[@]}"; do
      [[ -d "$stage_dir/.agents/skills/$name" ]] || die "install-skills: подготовленный навык не найден: $source#$name"
      replace_dir "$AGENT_SKILLS_CANONICAL_DIR/$name" "$stage_dir/.agents/skills/$name"
      managed_names+=("$name")
    done
  done
fi

agent_skills_append_preserved_bundles managed_names

prune_dir_except "$AGENT_SKILLS_CANONICAL_DIR" "${managed_names[@]}"

agent_skills_reconcile_layer

print "install-skills: синхронизировано навыков: ${#managed_names[@]}"
