#!/usr/bin/env zsh

emulate -LR zsh
set -euo pipefail

repo_root=${0:A:h:h:h}
tmp_root=$(mktemp -d "${TMPDIR:-/tmp}/instruction-projection.XXXXXX")
trap 'rm -rf "$tmp_root"' EXIT

fixture_root="$tmp_root/repo"
home_dir="$tmp_root/home"

mkdir -p \
  "$fixture_root/ai/instructions" \
  "$fixture_root/claude" \
  "$fixture_root/codex" \
  "$fixture_root/config/opencode" \
  "$fixture_root/scripts/lib" \
  "$fixture_root/scripts/tests" \
  "$home_dir"

cp "$repo_root/scripts/lib/install-common.zsh" "$fixture_root/scripts/lib/install-common.zsh"
cp "$repo_root/scripts/lib/instruction-projection.zsh" "$fixture_root/scripts/lib/instruction-projection.zsh"
cp "$repo_root/scripts/install-mcp" "$fixture_root/scripts/install-mcp"

cat > "$fixture_root/ai/instructions/one.md" <<'EOF'
# One

First instruction.
EOF

cat > "$fixture_root/ai/instructions/two.md" <<'EOF'
# Two

Second instruction.
EOF

cat > "$fixture_root/config/opencode/.opencode.template.jsonc" <<'EOF'
{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent"],
  "instructions": [
    "~/.agents/instructions/stale.md"
  ],
  "provider": {
    "example": {
      "name": "Example"
    }
  }
}
EOF

fail() {
  print -u2 -- "$1"
  exit 1
}

HOME="$home_dir" zsh -c "source '$fixture_root/scripts/lib/instruction-projection.zsh'; instruction_projection_sync '$fixture_root'"

[[ -f "$fixture_root/claude/CLAUDE.md" ]] || fail "missing generated Claude file"
[[ -f "$fixture_root/config/opencode/.opencode.template.jsonc" ]] || fail "missing generated OpenCode template"
[[ -f "$fixture_root/codex/AGENTS.md" ]] || fail "missing generated Codex AGENTS"
[[ -f "$home_dir/.cursor/rules/dotfiles.mdc" ]] || fail "missing generated Cursor rule"
[[ -L "$home_dir/.agents/instructions/one.md" ]] || fail "missing projected first instruction"
[[ -L "$home_dir/.agents/instructions/two.md" ]] || fail "missing projected second instruction"
[[ "$(< "$home_dir/.agents/instructions/one.md")" == $'# One\n\nFirst instruction.' ]] \
  || fail "unexpected projected first instruction"

expected_claude=$'# Глобальные инструкции\n\n@~/.agents/instructions/one.md\n@~/.agents/instructions/two.md'
actual_claude=$(< "$fixture_root/claude/CLAUDE.md")
[[ "$actual_claude" == "$expected_claude" ]] || fail "unexpected Claude imports"

actual_opencode=$(jq -c '.instructions' "$fixture_root/config/opencode/.opencode.template.jsonc")
[[ "$actual_opencode" == '["~/.agents/instructions/one.md","~/.agents/instructions/two.md"]' ]] || fail "unexpected OpenCode instructions"
[[ "$(jq -r '.provider.example.name' "$fixture_root/config/opencode/.opencode.template.jsonc")" == "Example" ]] || fail "OpenCode provider config was not preserved"

ugrep -Fq '<!-- GENERATED by scripts/build-agents-md from ai/instructions/*.md.' "$fixture_root/codex/AGENTS.md" || fail "Codex generated comment changed"
ugrep -Fq '# One' "$fixture_root/codex/AGENTS.md" || fail "Codex AGENTS missing first instruction"
ugrep -Fq '# Two' "$fixture_root/codex/AGENTS.md" || fail "Codex AGENTS missing second instruction"
ugrep -Fxq 'alwaysApply: true' "$home_dir/.cursor/rules/dotfiles.mdc" || fail "Cursor rule must always apply"
tail -n +6 "$home_dir/.cursor/rules/dotfiles.mdc" > "$tmp_root/cursor-body.md"
cmp "$fixture_root/codex/AGENTS.md" "$tmp_root/cursor-body.md" || fail "Cursor must include the same full instructions as Codex"

HOME="$home_dir" zsh -c "source '$fixture_root/scripts/lib/instruction-projection.zsh'; instruction_projection_check '$fixture_root'"

# Режим инструкций не зависит от реестров MCP и не загружает персональные секреты.
print 'return 99' > "$fixture_root/scripts/personal"
mkdir -p "$home_dir/.codex" "$home_dir/.claude" "$home_dir/.config/opencode"
print 'model = "preserve-model"' > "$home_dir/.codex/config.toml"
print '{"enabledPlugins":{"keep":true}}' > "$home_dir/.claude/settings.json"
print '{"mcpServers":{"keep":{}}}' > "$home_dir/.cursor/mcp.json"
print '{"model":"preserve-model","instructions":["keep"]}' > "$home_dir/.config/opencode/opencode.jsonc"
print '{"keep":true}' > "$home_dir/.claude.json"
local -a preserved_configs
preserved_configs=("$home_dir/.codex/config.toml" "$home_dir/.claude/settings.json" "$home_dir/.cursor/mcp.json" "$home_dir/.config/opencode/opencode.jsonc" "$home_dir/.claude.json")
cksum "${preserved_configs[@]}" > "$tmp_root/configs.before"
print 'Updated instruction.' >> "$fixture_root/ai/instructions/one.md"
if HOME="$home_dir" zsh "$fixture_root/scripts/install-mcp" --check-instructions >"$tmp_root/stale.log" 2>&1; then
  fail "instruction check accepted stale content"
fi
HOME="$home_dir" zsh "$fixture_root/scripts/install-mcp" --instructions-only
HOME="$home_dir" zsh "$fixture_root/scripts/install-mcp" --check-instructions
cksum "${preserved_configs[@]}" > "$tmp_root/configs.after"
cmp "$tmp_root/configs.before" "$tmp_root/configs.after" || fail "instruction sync changed client settings"
ugrep -Fq 'Updated instruction.' "$home_dir/.cursor/rules/dotfiles.mdc" || fail "Cursor rule was not refreshed"

# Не заменять чужое глобальное правило при совпадении пути.
print 'Пользовательское правило.' > "$home_dir/.cursor/rules/dotfiles.mdc"
if HOME="$home_dir" zsh "$fixture_root/scripts/install-mcp" --instructions-only >"$tmp_root/collision.log" 2>&1; then
  fail "instruction sync accepted an unmanaged Cursor rule"
fi
[[ "$(< "$home_dir/.cursor/rules/dotfiles.mdc")" == 'Пользовательское правило.' ]] || fail "unmanaged Cursor rule changed"

rm "$fixture_root/ai/instructions/"*.md

if HOME="$home_dir" zsh -c "source '$fixture_root/scripts/lib/instruction-projection.zsh'; instruction_projection_check '$fixture_root'" 2>"$tmp_root/missing.err"; then
  fail "empty instruction directory was accepted"
fi

ugrep -Fq "no instruction markdown files" "$tmp_root/missing.err" || fail "empty instruction directory error message missing"

print "test-instruction-projection: ok"
